# Byte-compiled / cache
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/

# Environments
.venv/
venv/
.env
.conda/

# Jupyter
.ipynb_checkpoints/

# Data & outputs (keep directory placeholders only)
data/**
!data/README.md
!data/**/.gitkeep
outputs/**
!outputs/.gitkeep

# Model weights / large arrays
*.pth
*.pt
*.npy
*.tif
*.tiff
*.svs
*.ndpi
*.pkl
*.pickle
*.h5
*.h5ad
*.ckpt

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp

# ---------------------------------------------------------------------------
# Benchmark runtime artifacts (keep scripts/configs; ignore local run outputs)
# ---------------------------------------------------------------------------
benchmark/istar/
benchmark/beacon_vs_istar/
benchmark/**/prepared/
benchmark/**/logs/
benchmark/**/weights/
benchmark/**/__pycache__/

# Large result trees; allow small metrics tables only
benchmark/beacon_vs_*/results/**
!benchmark/beacon_vs_*/results/
!benchmark/beacon_vs_*/results/metrics_summary.csv
!benchmark/beacon_vs_*/results/metrics_per_sample.csv

# iStar-only config (if present locally)
benchmark/configs/benchmark_visium.yaml

# ---------------------------------------------------------------------------
# GUI runtime / local demo images
# ---------------------------------------------------------------------------
gui/WSI_data/
gui_runs/
gui/**/__pycache__/
*.jpg
*.jpeg
*.png
!benchmark/figures/**
